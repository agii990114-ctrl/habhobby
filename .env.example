# 소셜 로그인 자격 증명. 채워진 제공자만 로그인 화면에 나타납니다.
# 하나도 없으면 로그인 없이 "이 기기" 로컬 계정으로 동작합니다.
#
# 실행:  BASE_URL=http://localhost:8080 KAKAO_CLIENT_ID=... npm start
# 또는 OS 환경 변수에 넣어두고 npm start

# 서비스 주소 — 리다이렉트 URI를 만드는 데 쓰입니다
BASE_URL=http://localhost:8080

# ── 카카오 ─────────────────────────────────────────────
# developers.kakao.com → 내 애플리케이션 → 앱 키의 "REST API 키"
# 카카오 로그인 활성화 ON
# Redirect URI 등록:  http://localhost:8080/auth/kakao/callback
KAKAO_CLIENT_ID=
# 보안 → Client Secret 을 "사용함"으로 두었을 때만 필요
KAKAO_CLIENT_SECRET=
# 기본은 아무 정보도 요청하지 않습니다(로그인만). 계정 화면에 닉네임·사진을
# 띄우고 싶으면 동의항목을 켠 뒤 아래 줄의 주석을 풀어주세요.
# KAKAO_SCOPE=profile_nickname profile_image

# ── 네이버 ─────────────────────────────────────────────
# developers.naver.com → 애플리케이션 등록 → 네이버 로그인
# Callback URL 등록:  http://localhost:8080/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 구글 ───────────────────────────────────────────────
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹)
# 승인된 리디렉션 URI:  http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
